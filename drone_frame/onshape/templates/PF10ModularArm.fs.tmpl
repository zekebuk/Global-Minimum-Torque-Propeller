FeatureScript $FS_VERSION;
import(path : "onshape/std/common.fs", version : "$FS_VERSION.0");

// PF10 Modular Arm - native, parametric Onshape custom feature.
// GENERATED by drone_frame/frame_pipeline/onshape_export.py on $DATE from the optimiser result.
// Defaults below are the optimised arm ($ARM_SUMMARY).
// Do not hand-edit defaults: change config/frame.yaml, re-run `python run_pipeline.py`, re-paste.
//
// Arm-local frame (same as the CadQuery reference): +X from the root face (x = 0) to the motor
// centre (x = L); top face (motor seat) at z = 0, material below. Print flight-top face down.
// Wire channel: pentagon with a 45 deg V at the flight-bottom -> a self-supporting roof as printed.

export enum PF10MotorPattern
{
    annotation { "Name" : "16x16 + 19x19" }
    BOTH,
    annotation { "Name" : "16x16 only" }
    M16,
    annotation { "Name" : "19x19 only" }
    M19
}

const ARM_L_BOUNDS = { (millimeter) : [40, $ARM_L, 300] } as LengthBoundSpec;
const ARM_B_BOUNDS = { (millimeter) : [8, $ARM_B, 40] } as LengthBoundSpec;
const ARM_HR_BOUNDS = { (millimeter) : [8, $ARM_HR, 50] } as LengthBoundSpec;
const ARM_HT_BOUNDS = { (millimeter) : [6, $ARM_HT, 50] } as LengthBoundSpec;
const ARM_TW_BOUNDS = { (millimeter) : [0.8, $ARM_TW, 8] } as LengthBoundSpec;
const ARM_TF_BOUNDS = { (millimeter) : [0.6, $ARM_TF, 8] } as LengthBoundSpec;
const TENON_L_BOUNDS = { (millimeter) : [10, $TENON_L, 60] } as LengthBoundSpec;
const TENON_B_BOUNDS = { (millimeter) : [10, $TENON_B, 70] } as LengthBoundSpec;
const PAD_D_BOUNDS = { (millimeter) : [20, $PAD_D, 50] } as LengthBoundSpec;
const CLAMP_BOUNDS = { (millimeter) : [2, $CLAMP_T, 10] } as LengthBoundSpec;
const BOLT_Y_BOUNDS = { (millimeter) : [3, $BOLT_Y, 40] } as LengthBoundSpec;

const SHAFT_D = $SHAFT_D * millimeter;
const HOLE_D = $HOLE_D * millimeter;
const CBORE_D = 6.2 * millimeter;
const M3_CLEAR = $M3_CLEAR * millimeter;
const CHAMFER = $TENON_CHAMFER * millimeter;
const P16 = $P16 * millimeter;
const P19 = $P19 * millimeter;

annotation { "Feature Type Name" : "PF10 Modular Arm",
             "Feature Type Description" : "Tapered hollow printed arm with tenon, wire channel and dual motor pattern" }
export const pf10ModularArm = defineFeature(function(context is Context, id is Id, definition is map)
    precondition
    {
        annotation { "Name" : "Free length (root face to motor centre)" }
        isLength(definition.armLength, ARM_L_BOUNDS);
        annotation { "Name" : "Width" }
        isLength(definition.width, ARM_B_BOUNDS);
        annotation { "Name" : "Root height" }
        isLength(definition.rootHeight, ARM_HR_BOUNDS);
        annotation { "Name" : "Tip height" }
        isLength(definition.tipHeight, ARM_HT_BOUNDS);
        annotation { "Name" : "Web thickness (wall loops x line width)" }
        isLength(definition.webThickness, ARM_TW_BOUNDS);
        annotation { "Name" : "Flange thickness (skin layers x layer height)" }
        isLength(definition.flangeThickness, ARM_TF_BOUNDS);
        annotation { "Name" : "Tenon length (inside socket)" }
        isLength(definition.tenonLength, TENON_L_BOUNDS);
        annotation { "Name" : "Tenon width (incl. bolt ears)" }
        isLength(definition.tenonWidth, TENON_B_BOUNDS);
        annotation { "Name" : "Tenon bolt lateral offset" }
        isLength(definition.boltOffset, BOLT_Y_BOUNDS);
        annotation { "Name" : "Motor pad diameter" }
        isLength(definition.padDiameter, PAD_D_BOUNDS);
        annotation { "Name" : "Material under motor bolt heads" }
        isLength(definition.clampThickness, CLAMP_BOUNDS);
        annotation { "Name" : "Motor pattern" }
        definition.motorPattern is PF10MotorPattern;
        annotation { "Name" : "Hollow wire channel", "Default" : true }
        definition.channel is boolean;
    }
    {
        const L = definition.armLength;
        const b = definition.width;
        const hr = definition.rootHeight;
        const ht = definition.tipHeight;
        const tw = definition.webThickness;
        const tf = definition.flangeThickness;
        const Lt = definition.tenonLength;
        const bt = definition.tenonWidth;
        const r = definition.padDiameter / 2;
        const zero = 0 * millimeter;

        if (ht > hr)
            throw regenError("Tip height must not exceed root height", ["tipHeight"]);
        if (bt <= b)
            throw regenError("Tenon width must exceed arm width (bolt ears)", ["tenonWidth"]);

        // 1. side profile (XZ), extruded symmetric about y = 0
        const sidePlane = plane(vector(zero, bt / 2 + 1 * millimeter, zero), vector(0, -1, 0), vector(1, 0, 0));
        const side = newSketchOnPlane(context, id + "sideSketch", { "sketchPlane" : sidePlane });
        skPolyline(side, "side", { "points" : [
                    vector(-Lt, zero), vector(L + r + 1 * millimeter, zero), vector(L + r + 1 * millimeter, -ht),
                    vector(L, -ht), vector(zero, -hr), vector(-Lt, -hr), vector(-Lt, zero)] });
        skSolve(side);
        opExtrude(context, id + "sideExtrude", {
                    "entities" : qSketchRegion(id + "sideSketch"),
                    "direction" : vector(0, -1, 0),
                    "endBound" : BoundingType.BLIND,
                    "endDepth" : bt + 2 * millimeter });

        // 2. plan profile (XY): tenon with bolt ears, 45 deg chamfer down to the arm width
        const planPlane = plane(vector(zero, zero, -hr - 1 * millimeter), vector(0, 0, 1), vector(1, 0, 0));
        const planSk = newSketchOnPlane(context, id + "planSketch", { "sketchPlane" : planPlane });
        skPolyline(planSk, "plan", { "points" : [
                    vector(-Lt, -bt / 2), vector(-CHAMFER, -bt / 2), vector(zero, -b / 2), vector(L, -b / 2),
                    vector(L, b / 2), vector(zero, b / 2), vector(-CHAMFER, bt / 2), vector(-Lt, bt / 2),
                    vector(-Lt, -bt / 2)] });
        skSolve(planSk);
        opExtrude(context, id + "planExtrude", {
                    "entities" : qSketchRegion(id + "planSketch"),
                    "direction" : vector(0, 0, 1),
                    "endBound" : BoundingType.BLIND,
                    "endDepth" : hr + 2 * millimeter });

        opBoolean(context, id + "intersect", {
                    "tools" : qUnion([qCreatedBy(id + "sideExtrude", EntityType.BODY), qCreatedBy(id + "planExtrude", EntityType.BODY)]),
                    "operationType" : BooleanOperationType.INTERSECTION });

        // 3. motor pad
        fCylinder(context, id + "pad", {
                    "bottomCenter" : vector(L, zero, -ht),
                    "topCenter" : vector(L, zero, zero),
                    "radius" : r });
        opBoolean(context, id + "unionPad", {
                    "tools" : qBodyType(qCreatedBy(id, EntityType.BODY), BodyType.SOLID),
                    "operationType" : BooleanOperationType.UNION });

        // 4. cutting tools (all under id + "tools")
        const tools = id + "tools";
        var n = 0;
        if (definition.channel)
        {
            const xEnd = L - r - 2 * millimeter;
            const hEnd = hr + (ht - hr) * (xEnd / L);
            const w = b - 2 * tw;
            if (hr - 2 * tf < w / 2 + 1 * millimeter || hEnd - 2 * tf < w / 2 + 1 * millimeter)
                throw regenError("Channel does not fit: increase height or webs, or reduce flanges", ["webThickness"]);
            const p0 = pentagon(hr, w, tf);
            const p1 = pentagon(hEnd, w, tf);
            const s0 = newSketchOnPlane(context, tools + "ch0", { "sketchPlane" : plane(vector(-Lt - 1 * millimeter, zero, zero), vector(1, 0, 0), vector(0, 1, 0)) });
            skPolyline(s0, "p", { "points" : p0 });
            skSolve(s0);
            opExtrude(context, tools + "prism", {
                        "entities" : qSketchRegion(tools + "ch0"),
                        "direction" : vector(1, 0, 0),
                        "endBound" : BoundingType.BLIND,
                        "endDepth" : Lt + 1 * millimeter });
            const s1 = newSketchOnPlane(context, tools + "ch1", { "sketchPlane" : plane(vector(zero, zero, zero), vector(1, 0, 0), vector(0, 1, 0)) });
            skPolyline(s1, "p", { "points" : p0 });
            skSolve(s1);
            const s2 = newSketchOnPlane(context, tools + "ch2", { "sketchPlane" : plane(vector(xEnd, zero, zero), vector(1, 0, 0), vector(0, 1, 0)) });
            skPolyline(s2, "p", { "points" : p1 });
            skSolve(s2);
            opLoft(context, tools + "loft", {
                        "profileSubqueries" : [qSketchRegion(tools + "ch1"), qSketchRegion(tools + "ch2")],
                        "bodyType" : ToolBodyType.SOLID });
            // wire exit slot through the top flange, just inboard of the motor base
            const xs = L - r - 5 * millimeter;
            const sw = min(6 * millimeter, w - 1 * millimeter);
            fCuboid(context, tools + "exit", {
                        "corner1" : vector(xs - 5 * millimeter, -sw / 2, -tf - 1 * millimeter),
                        "corner2" : vector(xs + 5 * millimeter, sw / 2, 1 * millimeter) });
        }

        fCylinder(context, tools + "shaft", {
                    "bottomCenter" : vector(L, zero, -hr - 1 * millimeter),
                    "topCenter" : vector(L, zero, 1 * millimeter),
                    "radius" : SHAFT_D / 2 });
        var holes = [];
        if (definition.motorPattern != PF10MotorPattern.M19)
        {
            const a = P16 / sqrt(2);
            holes = append(append(append(append(holes, vector(a, zero)), vector(-a, zero)), vector(zero, a)), vector(zero, -a));
        }
        if (definition.motorPattern != PF10MotorPattern.M16)
        {
            const c = P19 / 2;
            holes = append(append(append(append(holes, vector(c, c)), vector(c, -c)), vector(-c, c)), vector(-c, -c));
        }
        for (var h in holes)
        {
            fCylinder(context, tools + ("hole" ~ n), {
                        "bottomCenter" : vector(L + h[0], h[1], -hr - 1 * millimeter),
                        "topCenter" : vector(L + h[0], h[1], 1 * millimeter),
                        "radius" : HOLE_D / 2 });
            fCylinder(context, tools + ("cbore" ~ n), {
                        "bottomCenter" : vector(L + h[0], h[1], -hr - 1 * millimeter),
                        "topCenter" : vector(L + h[0], h[1], -definition.clampThickness),
                        "radius" : CBORE_D / 2 });
            n += 1;
        }
        for (var sy in [-1, 1])
        {
            fCylinder(context, tools + ("tenonBolt" ~ n), {
                        "bottomCenter" : vector(-Lt / 2, sy * definition.boltOffset, -hr - 1 * millimeter),
                        "topCenter" : vector(-Lt / 2, sy * definition.boltOffset, 1 * millimeter),
                        "radius" : M3_CLEAR / 2 });
            n += 1;
        }

        const toolBodies = qBodyType(qCreatedBy(tools, EntityType.BODY), BodyType.SOLID);
        opBoolean(context, id + "cut", {
                    "tools" : toolBodies,
                    "targets" : qSubtraction(qBodyType(qCreatedBy(id, EntityType.BODY), BodyType.SOLID), toolBodies),
                    "operationType" : BooleanOperationType.SUBTRACTION });

        // clean up construction sketches
        opDeleteBodies(context, id + "deleteSketches", {
                    "entities" : qSketchFilter(qCreatedBy(id, EntityType.BODY), SketchObject.YES) });
    },
    {
        "armLength" : $ARM_L * millimeter,
        "width" : $ARM_B * millimeter,
        "rootHeight" : $ARM_HR * millimeter,
        "tipHeight" : $ARM_HT * millimeter,
        "webThickness" : $ARM_TW * millimeter,
        "flangeThickness" : $ARM_TF * millimeter,
        "tenonLength" : $TENON_L * millimeter,
        "tenonWidth" : $TENON_B * millimeter,
        "boltOffset" : $BOLT_Y * millimeter,
        "padDiameter" : $PAD_D * millimeter,
        "clampThickness" : $CLAMP_T * millimeter,
        "motorPattern" : PF10MotorPattern.BOTH,
        "channel" : true
    });

// Channel pentagon in (y, z) sketch coordinates of a YZ plane: flat top under the top flange,
// vertical sides, 45 deg V to the apex at the flight-bottom.
function pentagon(h is ValueWithUnits, w is ValueWithUnits, tf is ValueWithUnits) returns array
{
    const zTop = -tf;
    const zApex = -h + tf;
    const zV = zApex + w / 2;
    return [vector(0 * millimeter, zApex), vector(w / 2, zV), vector(w / 2, zTop), vector(-w / 2, zTop),
            vector(-w / 2, zV), vector(0 * millimeter, zApex)];
}
