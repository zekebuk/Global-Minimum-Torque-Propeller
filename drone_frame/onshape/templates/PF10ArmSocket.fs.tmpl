FeatureScript $FS_VERSION;
import(path : "onshape/std/common.fs", version : "$FS_VERSION.0");

// PF10 Arm Socket - tapered sliding-dovetail socket for the PF10 Modular Arm.
// GENERATED by src/prandtl_prop/frame/onshape_export.py on $DATE.
//
// Body mode (default): cuts into the bottom body
//   - dovetail cavity: flanks + floor line-on-line with the seated tenon, straight upper sides opened by
//     the side clearance, open at the top, from the back gap out past the mouth (wider at the mouth, so
//     the arm always slides out freely)
//   - pigtail / MR30 window through the back wall
//   - 2 tie-bolt holes through the socket walls (top plate -> floor, washer + nyloc under the floor)
//   - 2 radial retention-screw slots in the floor (seat position floats by +/- home gap)
// Top-plate mode: cuts only the tie-bolt holes and the relief pocket over the tenon (the top plate
// must never touch the arm: the seat is flanks + floor only).
//
// Global frame: X forward, Y left, Z up, origin = body centre on the underside of the bottom plate.
// With "All four arms" the socket is mirrored to +/-angle and 180 -/+ angle (X frame).

const R_BOUNDS = { (millimeter) : [10, $ROOT_R, 200] } as LengthBoundSpec;
const Z_BOUNDS = { (millimeter) : [0, $Z_TOP, 100] } as LengthBoundSpec;
const H_BOUNDS = { (millimeter) : [5, $ARM_HR, 60] } as LengthBoundSpec;
const L_BOUNDS = { (millimeter) : [10, $TENON_L, 60] } as LengthBoundSpec;
const W_BOUNDS = { (millimeter) : [10, $TENON_B, 70] } as LengthBoundSpec;
const BW_BOUNDS = { (millimeter) : [1, $BACK_WALL, 12] } as LengthBoundSpec;
const RY_BOUNDS = { (millimeter) : [3, $BOLT_Y, 40] } as LengthBoundSpec;
const TY_BOUNDS = { (millimeter) : [3, $TIE_Y, 60] } as LengthBoundSpec;
const ANG_BOUNDS = { (degree) : [0, $ANGLE, 90] } as AngleBoundSpec;
const DV_DEPTH_BOUNDS = { (millimeter) : [2, $DV_DEPTH, 20] } as LengthBoundSpec;
const DV_ANGLE_BOUNDS = { (degree) : [5, $DV_ANGLE, 45] } as AngleBoundSpec;
const DV_TAPER_BOUNDS = { (unitless) : [0, $DV_TAPER, 0.2] } as RealBoundSpec;
const GAP_BOUNDS = { (millimeter) : [0, $HOME_GAP, 10] } as LengthBoundSpec;
const SIDE_BOUNDS = { (millimeter) : [0, $SIDE_CLEAR, 2] } as LengthBoundSpec;
const RELIEF_BOUNDS = { (millimeter) : [0, $TOP_RELIEF, 2] } as LengthBoundSpec;

const M3_CLEAR = $M3_CLEAR * millimeter;
const WINDOW_W = $WINDOW_W * millimeter;
const TOP_T = $T_TP * millimeter;

annotation { "Feature Type Name" : "PF10 Arm Socket" }
export const pf10ArmSocket = defineFeature(function(context is Context, id is Id, definition is map)
    precondition
    {
        annotation { "Name" : "Body to cut", "Filter" : EntityType.BODY && BodyType.SOLID, "MaxNumberOfPicks" : 1 }
        definition.target is Query;
        annotation { "Name" : "Top-plate mode (tie holes + relief only)", "Default" : false }
        definition.topPlateMode is boolean;
        annotation { "Name" : "Arm angle from +X" }
        isAngle(definition.angle, ANG_BOUNDS);
        annotation { "Name" : "All four arms (X symmetry)", "Default" : true }
        definition.allFour is boolean;
        annotation { "Name" : "Root-face radius" }
        isLength(definition.rootRadius, R_BOUNDS);
        annotation { "Name" : "Arm top Z (top-plate underside)" }
        isLength(definition.zTop, Z_BOUNDS);
        annotation { "Name" : "Arm root height" }
        isLength(definition.rootHeight, H_BOUNDS);
        annotation { "Name" : "Tenon length" }
        isLength(definition.tenonLength, L_BOUNDS);
        annotation { "Name" : "Tenon width at the mouth (incl. ears)" }
        isLength(definition.tenonWidth, W_BOUNDS);
        annotation { "Name" : "Dovetail foot depth" }
        isLength(definition.dovetailDepth, DV_DEPTH_BOUNDS);
        annotation { "Name" : "Dovetail flank angle (from vertical)" }
        isAngle(definition.flankAngle, DV_ANGLE_BOUNDS);
        annotation { "Name" : "Plan taper per side" }
        isReal(definition.taper, DV_TAPER_BOUNDS);
        annotation { "Name" : "Home gap behind seated tenon" }
        isLength(definition.homeGap, GAP_BOUNDS);
        annotation { "Name" : "Straight-side clearance" }
        isLength(definition.sideClearance, SIDE_BOUNDS);
        annotation { "Name" : "Top-plate relief" }
        isLength(definition.topRelief, RELIEF_BOUNDS);
        annotation { "Name" : "Back-wall thickness" }
        isLength(definition.backWall, BW_BOUNDS);
        annotation { "Name" : "Retention screw lateral offset" }
        isLength(definition.retentionOffset, RY_BOUNDS);
        annotation { "Name" : "Tie bolt lateral offset" }
        isLength(definition.tieOffset, TY_BOUNDS);
    }
    {
        const zero = 0 * millimeter;
        var angles = [definition.angle];
        if (definition.allFour)
            angles = [definition.angle, -definition.angle, 180 * degree + definition.angle, 180 * degree - definition.angle];
        const Lt = definition.tenonLength;
        const hw0 = definition.tenonWidth / 2;
        const flare = definition.dovetailDepth * tan(definition.flankAngle);
        const R0 = definition.rootRadius;
        const zTop = definition.zTop;
        const zFloor = zTop - definition.rootHeight;
        const xBack = -Lt - definition.homeGap;
        const tools = id + "tools";
        var k = 0;
        for (var a in angles)
        {
            const ca = cos(a);
            const sa = sin(a);
            const axis = vector(ca, sa, 0);
            const lateral = vector(-sa, ca, 0);
            // arm-local (x, y) relative to the root face -> global XY (2D vector)
            const P = function(x, y) { return vector(ca * (R0 + x) - sa * y, sa * (R0 + x) + ca * y); };
            const P3 = function(x, z) { const p = P(x, zero); return vector(p[0], p[1], z); };

            if (!definition.topPlateMode)
            {
                // dovetail cavity: ruled loft between sections normal to the arm axis (sketch y = +Z)
                const s0 = newSketchOnPlane(context, tools + ("cavSk0_" ~ k), { "sketchPlane" : plane(P3(xBack, zTop), axis, lateral) });
                skPolyline(s0, "p", { "points" : tenonSection(hw0, xBack, definition.taper, flare, definition.dovetailDepth,
                                                              definition.rootHeight, definition.sideClearance, 1 * millimeter) });
                skSolve(s0);
                const xMouth = 8 * millimeter;
                const s1 = newSketchOnPlane(context, tools + ("cavSk1_" ~ k), { "sketchPlane" : plane(P3(xMouth, zTop), axis, lateral) });
                skPolyline(s1, "p", { "points" : tenonSection(hw0, xMouth, definition.taper, flare, definition.dovetailDepth,
                                                              definition.rootHeight, definition.sideClearance, 1 * millimeter) });
                skSolve(s1);
                opLoft(context, tools + ("cavity" ~ k), {
                            "profileSubqueries" : [qSketchRegion(tools + ("cavSk0_" ~ k)), qSketchRegion(tools + ("cavSk1_" ~ k))],
                            "bodyType" : ToolBodyType.SOLID });

                // pigtail / MR30 window through the back wall
                const win = newSketchOnPlane(context, tools + ("winSk" ~ k), { "sketchPlane" : plane(vector(zero, zero, zFloor + 1.5 * millimeter), vector(0, 0, 1), vector(1, 0, 0)) });
                const xa = xBack - definition.backWall - 2 * millimeter;
                const xb = xBack + 0.5 * millimeter;
                skPolyline(win, "w", { "points" : [P(xa, -WINDOW_W / 2), P(xb, -WINDOW_W / 2), P(xb, WINDOW_W / 2), P(xa, WINDOW_W / 2), P(xa, -WINDOW_W / 2)] });
                skSolve(win);
                opExtrude(context, tools + ("win" ~ k), {
                            "entities" : qSketchRegion(tools + ("winSk" ~ k)),
                            "direction" : vector(0, 0, 1),
                            "endBound" : BoundingType.BLIND,
                            "endDepth" : definition.rootHeight + 1 * millimeter });

                // radial retention-screw slots through the floor (+/- home gap of seat travel)
                const sl = newSketchOnPlane(context, tools + ("slotSk" ~ k), { "sketchPlane" : plane(vector(zero, zero, -1 * millimeter), vector(0, 0, 1), vector(1, 0, 0)) });
                var c = 0;
                for (var sy in [-1, 1])
                {
                    const y = sy * definition.retentionOffset;
                    const x0 = -Lt / 2 - definition.homeGap;
                    const x1 = -Lt / 2 + definition.homeGap;
                    const r = M3_CLEAR / 2;
                    skPolyline(sl, "r" ~ c, { "points" : [P(x0, y - r), P(x1, y - r), P(x1, y + r), P(x0, y + r), P(x0, y - r)] });
                    skCircle(sl, "c0" ~ c, { "center" : P(x0, y), "radius" : r });
                    skCircle(sl, "c1" ~ c, { "center" : P(x1, y), "radius" : r });
                    c += 1;
                }
                skSolve(sl);
                opExtrude(context, tools + ("slot" ~ k), {
                            "entities" : qSketchRegion(tools + ("slotSk" ~ k)),
                            "direction" : vector(0, 0, 1),
                            "endBound" : BoundingType.BLIND,
                            "endDepth" : zFloor + 1.1 * millimeter });
            }
            else
            {
                // relief pocket in the top-plate underside over the tenon
                const rel = newSketchOnPlane(context, tools + ("relSk" ~ k), { "sketchPlane" : plane(vector(zero, zero, zTop - 0.01 * millimeter), vector(0, 0, 1), vector(1, 0, 0)) });
                const hw = hw0 + 0.5 * millimeter;
                const xa = xBack - 0.5 * millimeter;
                const xb = 1 * millimeter;
                skPolyline(rel, "r", { "points" : [P(xa, -hw), P(xb, -hw), P(xb, hw), P(xa, hw), P(xa, -hw)] });
                skSolve(rel);
                opExtrude(context, tools + ("relief" ~ k), {
                            "entities" : qSketchRegion(tools + ("relSk" ~ k)),
                            "direction" : vector(0, 0, 1),
                            "endBound" : BoundingType.BLIND,
                            "endDepth" : definition.topRelief + 0.01 * millimeter });
            }

            // steel tie bolts through the socket walls (both modes)
            for (var sy in [-1, 1])
            {
                const t = P(-Lt / 4, sy * definition.tieOffset);
                fCylinder(context, tools + ("tie" ~ k ~ "_" ~ (sy + 1)), {
                            "bottomCenter" : vector(t[0], t[1], -1 * millimeter),
                            "topCenter" : vector(t[0], t[1], zTop + TOP_T + 1 * millimeter),
                            "radius" : M3_CLEAR / 2 });
            }
            k += 1;
        }
        const toolBodies = qBodyType(qCreatedBy(tools, EntityType.BODY), BodyType.SOLID);
        opBoolean(context, id + "cut", {
                    "tools" : toolBodies,
                    "targets" : definition.target,
                    "operationType" : BooleanOperationType.SUBTRACTION });
        opDeleteBodies(context, id + "deleteSketches", {
                    "entities" : qSketchFilter(qCreatedBy(id, EntityType.BODY), SketchObject.YES) });
    },
    {
        "topPlateMode" : false,
        "angle" : $ANGLE * degree,
        "allFour" : true,
        "rootRadius" : $ROOT_R * millimeter,
        "zTop" : $Z_TOP * millimeter,
        "rootHeight" : $ARM_HR * millimeter,
        "tenonLength" : $TENON_L * millimeter,
        "tenonWidth" : $TENON_B * millimeter,
        "dovetailDepth" : $DV_DEPTH * millimeter,
        "flankAngle" : $DV_ANGLE * degree,
        "taper" : $DV_TAPER,
        "homeGap" : $HOME_GAP * millimeter,
        "sideClearance" : $SIDE_CLEAR * millimeter,
        "topRelief" : $TOP_RELIEF * millimeter,
        "backWall" : $BACK_WALL * millimeter,
        "retentionOffset" : $BOLT_Y * millimeter,
        "tieOffset" : $TIE_Y * millimeter
    });

// Identical to the function in PF10ModularArm.fs (keep them in sync - both are generated).
function tenonSection(hw0 is ValueWithUnits, x is ValueWithUnits, taper is number, flare is ValueWithUnits,
                      depth is ValueWithUnits, hr is ValueWithUnits, sideGrow is ValueWithUnits, top is ValueWithUnits) returns array
{
    const hw = hw0 + taper * x;
    const hf = hw + flare;
    const zKnee = -hr + (flare - sideGrow) * depth / flare;
    const ys = hw + sideGrow;
    return [vector(-hf, -hr), vector(hf, -hr), vector(ys, zKnee), vector(ys, top), vector(-ys, top), vector(-ys, zKnee), vector(-hf, -hr)];
}
